# Copy to .env (git-ignored) and adjust. Real secrets never go in this repo.
# Everything here is optional: `verbatim build-data` runs with no settings at all.
#
# Settings are read from, highest priority first:
#   environment variables > the KEYS_FILE file > .env > defaults in src/verbatim/config.py
# Nested settings use a double underscore: LLM__PROVIDER sets settings.llm.provider.

# Path to a file outside the repo that holds the API keys (needed for check-models):
#   GOOGLE_AI_API_KEY=...   (Google AI Studio, for Gemini)
#   GROQ_API_KEY=...        (Groq, for open-weights models)
# KEYS_FILE=~/secrets/verbatim.env

# Which provider to use: google | vertex | groq
LLM__PROVIDER=google
LLM__GEMINI_MODEL=gemini-3.5-flash-lite
LLM__GROQ_MODEL=openai/gpt-oss-20b

# Data location and split (defaults shown; paths are relative to where you run the command)
# DATA__ROOT=data
# DATA__TEST_FRACTION=0.2
# DATA__DEV_FRACTION=0.1
# DATA__SPLIT_SEED=42

# Only for the "vertex" provider (run `gcloud auth application-default login` first).
# Setting a project is what makes check-models try Vertex AI.
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
